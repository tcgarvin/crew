{
  "name": "crew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.deep.test.ts\" --exclude \"**/node_modules/**\"",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "lint": "biome check . && node scripts/check-refs.mjs",
    "format": "biome format --write .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "dependency-cruiser": "^16.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.12"
  }
}
