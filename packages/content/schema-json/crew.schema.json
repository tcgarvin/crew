{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "roleTags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["captain", "firstOfficer", "engineer", "pilot", "deckhand", "cook", "medic"]
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["engineering", "electrical", "piloting", "cargo", "medical", "cooking"]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
      }
    },
    "startingInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemDefId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["itemDefId", "count"],
        "additionalProperties": false
      }
    },
    "bio": {
      "type": "string"
    },
    "voice": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["id", "name", "roleTags", "skills", "startingInventory", "bio", "voice"],
  "additionalProperties": false
}
