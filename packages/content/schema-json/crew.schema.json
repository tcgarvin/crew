{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "roleTags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["captain", "firstOfficer", "engineer", "pilot", "deckhand", "cook", "medic"]
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["engineering", "electrical", "piloting", "cargo", "medical", "cooking", "fighting"]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
      }
    },
    "startingInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemDefId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["itemDefId", "count"],
        "additionalProperties": false
      }
    },
    "bio": {
      "type": "string"
    },
    "voice": {
      "type": "string",
      "minLength": 1
    },
    "interests": {
      "type": "object",
      "properties": {
        "likes": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cards",
              "boardgames",
              "vids",
              "debate",
              "music",
              "exercise",
              "sparring",
              "reading",
              "tinkering",
              "cooking",
              "stargazing",
              "gossip"
            ]
          }
        },
        "strong": {
          "type": "string",
          "enum": [
            "cards",
            "boardgames",
            "vids",
            "debate",
            "music",
            "exercise",
            "sparring",
            "reading",
            "tinkering",
            "cooking",
            "stargazing",
            "gossip"
          ]
        },
        "dislikes": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cards",
              "boardgames",
              "vids",
              "debate",
              "music",
              "exercise",
              "sparring",
              "reading",
              "tinkering",
              "cooking",
              "stargazing",
              "gossip"
            ]
          }
        }
      },
      "required": ["likes", "dislikes"],
      "additionalProperties": false
    },
    "values": {
      "type": "object",
      "properties": {
        "orderFreedom": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "faithReason": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        },
        "loyaltyAmbition": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        }
      },
      "required": ["orderFreedom", "faithReason", "loyaltyAmbition"],
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "roleTags", "skills", "startingInventory", "bio", "voice"],
  "additionalProperties": false
}
