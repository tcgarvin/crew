{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "deckId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "startPortId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "crew": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
      }
    },
    "startingMoney": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "startingItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemDefId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "zoneKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "required": ["itemDefId", "count", "zoneKey"],
        "additionalProperties": false
      }
    },
    "initialFaults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "placementKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "faultKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "required": ["placementKey", "faultKey"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "deckId",
    "startPortId",
    "crew",
    "startingMoney",
    "startingItems",
    "initialFaults"
  ],
  "additionalProperties": false
}
