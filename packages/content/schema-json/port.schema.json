{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "character": {
      "type": "string",
      "minLength": 1
    },
    "castSeed": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "post": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "required": ["name", "role", "note"],
        "additionalProperties": false
      }
    },
    "externalStores": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["warehouse", "market", "lounge"]
          }
        },
        "required": ["key", "name", "kind"],
        "additionalProperties": false
      }
    },
    "market": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemDefId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": ["itemDefId", "count", "price"],
        "additionalProperties": false
      }
    },
    "jobTemplates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "toPortId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "cargo": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemDefId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
                },
                "countMin": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "countMax": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": ["itemDefId", "countMin", "countMax"],
              "additionalProperties": false
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": ["key", "issuer", "toPortId", "cargo", "weight"],
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "toPortId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "distance": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": ["toPortId", "distance"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "character",
    "castSeed",
    "externalStores",
    "market",
    "jobTemplates",
    "routes"
  ],
  "additionalProperties": false
}
