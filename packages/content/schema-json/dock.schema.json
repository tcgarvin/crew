{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "portId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "palette": {
      "type": "object",
      "properties": {
        "floor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "wall": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "sky": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": ["floor", "wall", "accent"],
      "additionalProperties": false
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rows": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "legend": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["floor", "wall", "void"]
      }
    },
    "berth": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        },
        "sizeClass": {
          "type": "string",
          "enum": ["S", "M", "L"]
        }
      },
      "required": ["origin", "sizeClass"],
      "additionalProperties": false
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": ["gate", "warehouseDoor", "marketStall", "kiosk", "loungeDoor", "bench"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tile": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "facing": {
            "type": "string",
            "enum": ["n", "e", "s", "w"]
          }
        },
        "required": ["key", "kind", "name", "tile", "facing"],
        "additionalProperties": false
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": ["freightStaging", "deliveryBay"]
          },
          "rect": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "w": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "h": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false
          }
        },
        "required": ["key", "kind", "rect"],
        "additionalProperties": false
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "crates",
              "container",
              "crane",
              "hullSection",
              "planter",
              "conveyor",
              "bollard",
              "lamp",
              "barrels",
              "rock"
            ]
          },
          "rect": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "w": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "h": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false
          },
          "rot": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": ["key", "kind", "rect", "rot", "blocking"],
        "additionalProperties": false
      }
    },
    "foreground": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["bayWall", "gantry", "terminalEdge", "awning", "rockWall"]
          },
          "rect": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "w": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "h": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false
          }
        },
        "required": ["kind", "rect"],
        "additionalProperties": false
      }
    },
    "ambience": {
      "type": "string",
      "minLength": 1
    },
    "grime": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "airborneDust": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "id",
    "portId",
    "name",
    "palette",
    "width",
    "height",
    "rows",
    "legend",
    "berth",
    "posts",
    "areas",
    "props",
    "foreground",
    "ambience",
    "grime",
    "airborneDust"
  ],
  "additionalProperties": false
}
