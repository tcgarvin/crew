{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stacking": {
      "type": "string",
      "enum": ["unique", "stackable"]
    },
    "maxStack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tool",
          "consumable",
          "food",
          "spare",
          "cargo",
          "medical",
          "container",
          "personal",
          "provisions",
          "meal",
          "book",
          "instrument",
          "treat",
          "patchKit",
          "plating",
          "weapon"
        ]
      }
    },
    "toolKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["wrench", "multimeter", "welder", "diagnosticScanner", "handTruck", "mop"]
      }
    },
    "mass": {
      "type": "number",
      "minimum": 0
    },
    "cargoClass": {
      "type": "string",
      "enum": ["general", "fragile", "perishable", "hazardous"]
    },
    "nutrition": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "capacityUnits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "weapon": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["blaster", "baton"]
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "aimSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hit": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "severity": {
          "type": "string",
          "enum": ["graze", "serious", "grave"]
        },
        "damageType": {
          "type": "string",
          "enum": ["blaster", "blunt"]
        },
        "stun": {
          "type": "boolean"
        }
      },
      "required": ["kind", "range", "aimSeconds", "hit", "severity", "damageType", "stun"],
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "stacking", "maxStack", "tags", "toolKinds", "mass"],
  "additionalProperties": false
}
