{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "tiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compartments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1,
            "pattern": "^\\S$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["key", "symbol", "name", "tags"],
        "additionalProperties": false
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "edge": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "side": {
                "type": "string",
                "enum": ["n", "e", "s", "w"]
              }
            },
            "required": ["x", "y", "side"],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": ["interior", "ramp"]
          },
          "powerDomain": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "manualOperationSupported": {
            "type": "boolean"
          },
          "initialState": {
            "type": "string",
            "enum": ["open", "closed"]
          }
        },
        "required": ["key", "edge", "kind", "manualOperationSupported", "initialState"],
        "additionalProperties": false
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "side": {
            "type": "string",
            "enum": ["n", "e", "s", "w"]
          }
        },
        "required": ["x", "y", "side"],
        "additionalProperties": false
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "side": {
            "type": "string",
            "enum": ["n", "e", "s", "w"]
          }
        },
        "required": ["x", "y", "side"],
        "additionalProperties": false
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "machineDefId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "origin": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "rotation": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "powerDomain": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "required": ["key", "machineDefId", "origin", "rotation"],
        "additionalProperties": false
      }
    },
    "powerDomains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["key", "name"],
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tiles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            }
          }
        },
        "required": ["key", "name", "tags", "tiles"],
        "additionalProperties": false
      }
    },
    "docking": {
      "type": "object",
      "properties": {
        "cargoRampDoorKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "personnelRampDoorKey": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "cargoTransferTiles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          }
        },
        "personnelTransferTiles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cargoRampDoorKey",
        "personnelRampDoorKey",
        "cargoTransferTiles",
        "personnelTransferTiles"
      ],
      "additionalProperties": false
    },
    "spawnPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "tile": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": ["x", "y"],
            "additionalProperties": false
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["crew", "passenger", "cargo"]
            }
          }
        },
        "required": ["key", "tile", "tags"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "width",
    "height",
    "tiles",
    "compartments",
    "doors",
    "openings",
    "walls",
    "machines",
    "powerDomains",
    "zones",
    "docking",
    "spawnPoints"
  ],
  "additionalProperties": false
}
