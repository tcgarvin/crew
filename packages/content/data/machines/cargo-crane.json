{
  "$schema": "../../schema-json/machine.schema.json",
  "id": "machine.cargo_crane",
  "name": "Cargo Crane",
  "tags": ["rampControl"],
  "footprint": [
    {
      "x": 0,
      "y": 0
    },
    {
      "x": 1,
      "y": 0
    }
  ],
  "interactionPositions": [
    {
      "key": "controls",
      "offset": {
        "x": 0,
        "y": -1
      },
      "purposes": ["operate", "repair"],
      "capacity": 1
    }
  ],
  "power": {
    "role": "consumer",
    "drawKw": 10,
    "priority": "cargo",
    "partialPower": "off"
  },
  "heat": {
    "risePerSecond": 0.003,
    "coolPerSecond": 0.02,
    "derateAbove": 0.9
  },
  "operation": {
    "requiresOperator": true,
    "operatorSkill": {
      "skill": "cargo",
      "min": 2
    }
  },
  "failure": {
    "baseHazardPerSecond": 0.0007,
    "heatFactor": 1,
    "wearPerSecond": 0.0009
  },
  "faults": [
    {
      "key": "jammed_actuator",
      "name": "Jammed actuator",
      "weight": 1,
      "effect": {
        "kind": "inoperable"
      },
      "symptom": {
        "key": "stuck_arm",
        "channel": "visual"
      },
      "repair": {
        "steps": [
          {
            "key": "free_actuator",
            "action": "repair",
            "workSeconds": 10,
            "tools": ["wrench"],
            "consumes": [
              {
                "itemDefId": "item.spare_parts_stack",
                "count": 1
              }
            ],
            "at": "repair",
            "skill": {
              "skill": "engineering",
              "min": 1
            }
          },
          {
            "key": "test_crane",
            "action": "test",
            "workSeconds": 5,
            "tools": [],
            "consumes": [],
            "at": "repair"
          }
        ]
      }
    }
  ],
  "components": [
    {
      "slot": "actuator",
      "itemDefId": "item.spare_parts_stack"
    }
  ]
}
