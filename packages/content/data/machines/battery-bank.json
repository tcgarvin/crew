{
  "$schema": "../../schema-json/machine.schema.json",
  "id": "machine.battery_bank",
  "name": "Battery Bank",
  "tags": ["battery"],
  "footprint": [
    {
      "x": 0,
      "y": 0
    },
    {
      "x": 1,
      "y": 0
    }
  ],
  "interactionPositions": [
    {
      "key": "panel",
      "offset": {
        "x": 0,
        "y": 1
      },
      "purposes": ["repair"],
      "capacity": 1
    }
  ],
  "power": {
    "role": "battery",
    "capacityKj": 36000,
    "maxChargeKw": 20,
    "maxDischargeKw": 30
  },
  "heat": {
    "risePerSecond": 0.005,
    "coolPerSecond": 0.01,
    "derateAbove": 0.85
  },
  "operation": {
    "requiresOperator": false
  },
  "failure": {
    "baseHazardPerSecond": 0.00004,
    "heatFactor": 2,
    "wearPerSecond": 0.0003
  },
  "faults": [
    {
      "key": "cell_degradation",
      "name": "Degraded battery cell",
      "weight": 1,
      "effect": {
        "kind": "derate",
        "outputFactor": 0.5
      },
      "symptom": {
        "key": "charge_sagging",
        "channel": "sensor"
      },
      "repair": {
        "steps": [
          {
            "key": "test_cells",
            "action": "inspect",
            "workSeconds": 8,
            "tools": ["multimeter"],
            "consumes": [],
            "at": "repair",
            "skill": {
              "skill": "electrical",
              "min": 2
            }
          },
          {
            "key": "replace_cell",
            "action": "installComponent",
            "workSeconds": 15,
            "tools": ["wrench"],
            "consumes": [
              {
                "itemDefId": "item.spare_parts_stack",
                "count": 1
              }
            ],
            "at": "repair",
            "skill": {
              "skill": "electrical",
              "min": 2
            }
          },
          {
            "key": "test_bank",
            "action": "test",
            "workSeconds": 5,
            "tools": ["multimeter"],
            "consumes": [],
            "at": "repair"
          }
        ]
      }
    }
  ],
  "components": [],
  "maintenance": {
    "intervalSeconds": 600,
    "inspect": {
      "key": "routine_inspect",
      "action": "inspect",
      "workSeconds": 10,
      "tools": ["multimeter"],
      "consumes": [],
      "at": "repair",
      "skill": {
        "skill": "electrical",
        "min": 1
      }
    },
    "conditionRestored": 1
  }
}
